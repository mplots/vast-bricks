{
  "manifest_version": 3,
  "name": "BrickOwl Tools",
  "version": "1.0",
  "description": "Adds BrickOwl order shipping-label tools.",
  "permissions": [],
  "host_permissions": [
    "https://www.brickowl.com/*",
    "https://tool.vastbricks.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.brickowl.com/mystore/orders/history/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
