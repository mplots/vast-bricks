#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for candidate in \
  "${VAST_NODE:-}" \
  "/opt/homebrew/opt/node@24/bin/node" \
  "/opt/homebrew/opt/node/bin/node" \
  "/opt/homebrew/bin/node" \
  "/usr/local/bin/node" \
  "node"
do
  if [ -z "$candidate" ]; then
    continue
  fi

  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version >/dev/null 2>&1; then
    exec "$candidate" "$script_dir/vast-tools/cli.mjs" "$@"
  fi
done

echo "No working Node.js executable found. Install or fix Node, then retry." >&2
exit 1
