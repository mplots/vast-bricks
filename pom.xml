<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.vastbricks</groupId>
    <artifactId>vb-parent</artifactId>
    <name>Vast Bricks</name>
    <packaging>pom</packaging>
    <version>1.0</version>

    <properties>
        <wiremock-standalone.version>3.13.2</wiremock-standalone.version>
    </properties>

    <modules>
        <module>vast-services</module>
        <module>vast-api</module>
        <module>vb-portal-api</module>
    </modules>

    <build>
        <plugins>
            <!-- Required by ./vast service orchestration. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>resolve-wiremock-standalone</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>get</goal>
                        </goals>
                        <configuration>
                            <artifact>org.wiremock:wiremock-standalone:${wiremock-standalone.version}</artifact>
                            <transitive>false</transitive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
